# =============================================================================
# .env.production — Production environment variables
# Copy to .env on the Debian host; NEVER commit real values.
# =============================================================================

# ---- Domain ----
PRIMARY_DOMAIN=shorbornoai.com

# ---- Cloudflare Tunnel ----
TUNNEL_TOKEN=eyJh...your-real-tunnel-token...

# ---- Auth ----
NEXTAUTH_SECRET=run: openssl rand -base64 32

# ---- Database ----
POSTGRES_PASSWORD=use-a-32-char-random-string

# ---- Vector adapter ----
VECTOR_ADAPTER=qdrant

# ---- Microsoft / Azure ----
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ---- GitHub App ----
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=

# ---- Local AI ----
LOCAL_AI_BASE_URL=http://localhost:11434
LOCAL_AI_API_KEY=

# ---- Deploy (for Makefile deploy target) ----
DEPLOY_HOST=
DEPLOY_USER=deploy
