# =============================================================================
# .env.example  —  copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# ---- Primary domain (used for public hostnames) ----
PRIMARY_DOMAIN=shorbornoai.com

# ---- Cloudflare Tunnel (remotely-managed, dashboard token) ----
# Get this from: Tunnels → Create tunnel → copy the token
TUNNEL_TOKEN=eyJh...your-tunnel-token...

# ---- Next.js / Auth ----
NEXTAUTH_SECRET=generate-with: openssl rand -base64 32

# ---- PostgreSQL ----
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ---- Vector adapter: "qdrant" or "pgvector" ----
VECTOR_ADAPTER=qdrant

# ---- Microsoft / Azure adapter ----
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ---- Google adapter (service account JSON at secrets/google-sa.json) ----
# GOOGLE_APPLICATION_CREDENTIALS is set in docker-compose; just place the file.

# ---- GitHub App adapter (private key at secrets/github-app.pem) ----
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=

# ---- Local AI provider adapter ----
LOCAL_AI_BASE_URL=http://localhost:11434
LOCAL_AI_API_KEY=
