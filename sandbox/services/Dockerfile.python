# =============================================================================
# Base Dockerfile for ALL Python/FastAPI services — multi-stage, Alpine, non-root
# Shared by: ingestion, neteng, cyberrange, shorborno
# Build: docker build --build-arg SERVICE=ingestion -t fabric-ingest services/ingestion
# =============================================================================

# ---------- Stage 1: Builder ----------
FROM python:3.13-alpine AS builder

# Install build deps for compiled Python packages (psycopg, cryptography, etc.)
RUN apk add --no-cache \
    build-base \
    libffi-dev \
    openssl-dev \
    postgresql-dev \
    musl-dev \
    cargo

# Create venv in /opt/venv so we copy only built artifacts to runtime
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /build

# Copy only dependency manifests first for layer caching
COPY services/${SERVICE}/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# ---------- Stage 2: Runtime (minimal Alpine, non-root UID 1001) ----------
FROM python:3.13-alpine AS runtime

# Runtime-only libs (no build tools, no compilers)
RUN apk add --no-cache \
    libpq \
    libffi \
    curl \
    tini \
    && addgroup -g 1001 -S appgroup \
    && adduser -u 1001 -S appuser -G appgroup -h /app

# Copy the venv from builder (pre-built wheels only)
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Copy service source
COPY --chown=1001:1001 services/${SERVICE}/app ./app
COPY --chown=1001:1001 infra/entrypoint.sh /entrypoint.sh
COPY --chown=1001:1001 infra/healthcheck.py /healthcheck.py

RUN chmod 0555 /entrypoint.sh /healthcheck.py

USER 1001:1001

EXPOSE ${PORT}

# tini for proper signal handling (PID 1 zombie reaping)
ENTRYPOINT ["/sbin/tini", "--", "/entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
